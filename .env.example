# Connection settings. Copy to .env and fill in.
#
# The file is looked up next to the script, not in the current working directory
# (override with --env-file). Precedence depends on whether the file was named
# explicitly: with the default .env the process environment wins, with an explicit
# --env-file the file wins, because naming a file is you choosing which router to
# talk to.

# Router address. A full URL with a scheme is accepted (https://router.lan:8443):
# the scheme then overrides KEENETIC_SSL and the port overrides KEENETIC_PORT.
# A path in the value is rejected.
KEENETIC_HOST=192.168.1.1
KEENETIC_PORT=80
# Exactly these count as true: 1, true, yes, y, on (case-insensitive). Anything else is false.
KEENETIC_SSL=false
KEENETIC_USERNAME=admin

# The password. Two places it can live, read in this order:
#
#   1. KEENETIC_PASSWORD, from the environment or from this file
#   2. the macOS keychain
#
# Whichever comes first wins, so setting the variable below means the keychain is
# never consulted.
#
# On any system, just set it here. This file is in .gitignore and stays in your own
# home directory. Outside macOS this is the only option.
#
# KEENETIC_PASSWORD=your-router-password
#
# On macOS you can instead keep it in the keychain, so no file holds it in the clear.
# Run this and paste the password into the prompt that appears:
#
#   security add-generic-password -U -s keenetic -a <router-username> -w
#
# Then leave KEENETIC_PASSWORD unset here. The keychain item is keyed by the *router*
# username, so a second router pointed at with --env-file looks up its own password
# rather than reusing this one.

# Timeout for each HTTP request in seconds - not a connect timeout and not a budget
# for the whole run: one command makes several requests (authentication plus reads).
# Must be positive: 0 is not "no limit", it disables aiohttp's timer entirely.
KEENETIC_TIMEOUT=30
